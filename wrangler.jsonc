// Cloudflare Workers config: serves this repo's static files, plus a small
// Worker for the contact form at /api/contact.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker; everything else is served as a file
    "run_worker_first": ["/api/*"]
  },
  // Not secret. RESEND_API_KEY, TURNSTILE_SECRET and CONTACT_TO are secrets:
  // set them with `wrangler secret put <NAME>` (or .dev.vars locally).
  "vars": {
    "CONTACT_FROM": "Contact Form <form@mail.stephenfillers.com>"
  },
  // Required by `wrangler preview`, which Workers Builds runs for pull requests.
  // Docs: https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {}
}
